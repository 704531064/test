page {
  background: #f6f8fb;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: #222;
}
.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 20rpx;
  margin: 18rpx 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.06);
}
.title {
  font-weight: 700;
  font-size: 32rpx;
  margin-bottom: 10rpx;
}
.btn-row {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin: 10rpx 0;
}
.small {
  color: #666;
  font-size: 24rpx;
}
.pill {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #dbeafe;
  margin-right: 8rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
